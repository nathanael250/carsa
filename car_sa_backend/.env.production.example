# PRODUCTION: the live database.
# Copy to .env.production, fill in the values, then run: npm run start:production
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=car_sa
DB_USER=
DB_PASS=
PORT=5001
# Must differ between testing and production, so a test login never works on live.
JWT_SECRET=
API_KEY=

EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Live TransPip keys.
TRANSPIP_PAYMENTS_URL=https://payments.transpip.com
TRANSPIP_COMMON_API_KEY=
TRANSPIP_TENANT_API_KEY=
TRANSPIP_WEBHOOK_SECRET=

FIREBASE_SERVICE_ACCOUNT_BASE64=
# Public address of the web panel; used for resellers' share links (…/join?ref=CODE)
PUBLIC_WEB_URL=
RESELLER_MIN_PAYOUT=1000
OIL_REMINDERS_ENABLED=true

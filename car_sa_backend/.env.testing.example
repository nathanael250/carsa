# TESTING: a separate database whose name contains "test". Never the live one.
# Copy to .env.testing, fill in the values, then run: npm run start:testing
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carsa_test
DB_USER=
DB_PASS=
PORT=5002
# Must differ between testing and production, so a test login never works on live.
JWT_SECRET=
API_KEY=

EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Use TransPip test/sandbox keys here, never live ones.
TRANSPIP_PAYMENTS_URL=https://payments.transpip.com
TRANSPIP_COMMON_API_KEY=
TRANSPIP_TENANT_API_KEY=
TRANSPIP_WEBHOOK_SECRET=

FIREBASE_SERVICE_ACCOUNT_BASE64=
RESELLER_MIN_PAYOUT=1000
OIL_REMINDERS_ENABLED=true
